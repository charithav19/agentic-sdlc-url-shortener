# Copy to .env; used by the database-only Compose bootstrap.
# These are local example passwords. Replace them before starting the databases.
URL_DB_NAME=url_shortener
URL_DB_USER=url_shortener
URL_DB_PASSWORD=replace-with-local-url-password
URL_DB_PORT=5433
URL_DB_CONNECTION_TIMEOUT_MS=3000
URL_CREATE_RATE_CAPACITY=60
URL_CREATE_RATE_WINDOW=1m
URL_ANALYTICS_ENABLED=true
URL_ANALYTICS_MAX_THREADS=2
URL_ANALYTICS_QUEUE_CAPACITY=100
ORCHESTRATOR_DB_NAME=orchestrator
ORCHESTRATOR_DB_USER=orchestrator
ORCHESTRATOR_DB_PASSWORD=replace-with-local-orchestrator-password
ORCHESTRATOR_DB_HOST=127.0.0.1
ORCHESTRATOR_DB_PORT=5434
ORCHESTRATOR_DB_CONNECT_TIMEOUT_SECONDS=3
ORCHESTRATOR_LOG_LEVEL=INFO
# Local prototype credential for human approval endpoints. Replace before use.
ORCHESTRATOR_LOCAL_REVIEWER_TOKEN=replace-with-local-reviewer-token
ORCHESTRATOR_MAX_PARALLEL_STAGES=3
ORCHESTRATOR_STAGE_CLAIM_LEASE_SECONDS=300

# SDK is the primary runtime. Set fake for explicit deterministic fixture playback.
# Export these into the trusted Python process; never pass the key to a workspace.
AGENT_PROVIDER=openai
OPENAI_API_KEY=
# Required in openai mode: set an account-accessible model supporting structured outputs.
OPENAI_MODEL=
# Opt-in only, used by the live smoke test (ordinary tests use fake/stub providers).
RUN_LIVE_AGENT_TESTS=0
URL_BASE_URL=http://localhost:8080
ORCHESTRATOR_BASE_URL=http://localhost:8000
STAGE_MAX_ATTEMPTS=2
